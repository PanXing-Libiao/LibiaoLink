{
  "name": "@libiaolink/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "LibiaoLink /api/v1 契约包：Zod schema 唯一真相 → OpenAPI 3.1 与前端类型生成（g2 · S5·契约包）",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "generate": "node scripts/generate.mjs",
    "generate:openapi": "node scripts/generate.mjs --only=openapi",
    "generate:client": "node scripts/generate.mjs --only=client",
    "check": "node scripts/check-drift.mjs && node scripts/check-request-array-bounds.mjs",
    "check:request-array-bounds": "node scripts/check-request-array-bounds.mjs",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./generated/*": "./generated/*"
  }
}
