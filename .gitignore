# 环境变量与密钥
.env
.env.*
!.env.example

# Casdoor 运行数据（files/ 只保留自托管的品牌资源，其余是上传件）
deploy/casdoor/files/*
!deploy/casdoor/files/brand/
deploy/casdoor/logs/
deploy/casdoor/backup/
deploy/casdoor/tmp/

# Node
node_modules/
npm-debug.log*

# 系统
.DS_Store
Thumbs.db

# 生产部署密钥（文件挂载；只存在于本机 / 服务器）
deploy/prod/secrets/
# 生产环境变量（服务器本地生成，不进仓库；模板 server.env.example 进仓库）
deploy/prod/server.env

# 服务器登录备忘（本机未跟踪 · 供 AI / 值班取用）
deploy/prod/*.local.md

# CAD runtime/cache (source release remains tracked)
server/var/cad/
server/var/cad-browser-smoke/
server/cad-engine/.runtime/
server/cad-engine/**/__pycache__/
