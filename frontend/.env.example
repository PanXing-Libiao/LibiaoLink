# LibiaoLink 前端本地联调（k6：会话链路已切到后端 server/）
# 复制为 .env.local 后按需修改；.env.local 被 gitignore，仓库不存真实值。

# 后端 api 地址：Vite 开发服务器把 /auth/*、/healthz、/readyz 代理到这里。
# 注意：后端默认 PORT=3000 与前端冲突，本地请把 server/.env 的 PORT 设为 3001。
BACKEND_ORIGIN=http://127.0.0.1:3001

# npm run smoke 冒烟测试用的本地沙箱账号（口令不落仓库；也可在 deploy/casdoor/.env.local 配置）
TEST_USERNAME=
TEST_PASSWORD=

# 可选：冒烟测试覆盖 Casdoor 应用 / 组织名（默认 libiaolink / libiaorobot）
# CASDOOR_APPLICATION=libiaolink
# CASDOOR_ORGANIZATION=libiaorobot

# 导出报告英译通道：Push 301 起翻译全链路在服务端（server/.env 的 TRANSLATE_ORIGIN 指向 HY-MT1.5-1.8B 引擎，
# 默认 http://127.0.0.1:5008；前端不再使用本变量、也不再直连引擎，见 §6.16 ㉕）。
# TRANSLATE_ORIGIN=http://127.0.0.1:5008
