# 本地开发示例；真实值不落仓库（CONTRIBUTING §12）
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://libiaolink_api@127.0.0.1:5432/libiaolink
LOG_LEVEL=debug

# 站外页面深链基址（日报项目群消息中的项目日报链接）；本地域名暂不配置，缺省 = 生产站点
# PUBLIC_APP_BASE_URL=https://pm.libiaorobot.com

# ---- 认证与会话（/auth/*，ADR-010；g6） ----
# 本地沙箱见 deploy/casdoor/（px 维护）；生产环境 CLIENT_ID / CLIENT_SECRET 必填（启动即校验）
CASDOOR_ISSUER=http://localhost:8000
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
CASDOOR_REDIRECT_URI=http://localhost:3000/auth/callback
CASDOOR_SCOPE=openid profile email
# 会话空闲超时（分钟；接入标准「企业内部系统」档为 30）
SESSION_IDLE_MINUTES=30
# auto = 仅 production 时给 Cookie 加 Secure
SESSION_COOKIE_SECURE=auto

# ---- 组织同步与内部作业（h1 收口；生产必填，启动即校验） ----
# 目录同步 owner（Casdoor 组织名；本地沙箱 libiaorobot，公司环境 libiaorobot.com）
CASDOOR_ORG_NAME=libiaorobot
# Casdoor 群组 / 用户目录自动同步周期（毫秒；worker 启动即跑一轮，默认 5 分钟）
ORG_SYNC_INTERVAL_MS=300000
# 内部作业接口凭证（请求头 X-Internal-Token；离职回收 / 目录同步手动触发）
INTERNAL_SYNC_TOKEN=

# ---- 群组访问限制（Casdoor Groups） ----
# 本地默认 false = 规则可保存但不参与裁定；生产启动强制要求 true（缺省 / false 会直接失败）。
# 开启前必须在 Casdoor 应用 Token Fields 勾选 Groups，并让账号重新登录写入群组关系。
# 管理员群组键用 owner/name 逗号分隔，例如 libiaorobot.com/系统管理员；开启限制时必须配置。
GROUP_ACCESS_ENFORCED=false
GROUP_ACCESS_ADMIN_GROUP_KEYS=


# ---- 对象存储（ADR-006：S3 协议抽象；本地沙箱见 deploy/minio/） ----
# 生产环境 ACCESS_KEY / SECRET_KEY 必填（启动即校验）；真实值不落仓库（CONTRIBUTING §12）
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=libiaolink
# auto = 非 AWS 端点走 path-style（MinIO / SeaweedFS 必需），AWS 走 virtual-host
S3_FORCE_PATH_STYLE=auto
# 分片直传预签名有效期（秒）与下载短时签名有效期（秒）
S3_PART_URL_TTL_SECONDS=900
S3_DOWNLOAD_URL_TTL_SECONDS=300
# 单文件大小上限（MB）
UPLOAD_MAX_SIZE_MB=2048
# 上传会话有效期（小时；过期不可续传，worker 定时清理未完成分片与暂存对象）
UPLOAD_SESSION_TTL_HOURS=24
# 回收站保留期（天；到期由 worker 彻底删除：对象按版本清 + 元数据删 + 留痕）
FILE_RECYCLE_RETENTION_DAYS=30

# ---- SVG 预览栅格化（H1 · S4：converter 落点 deploy/svg-preview/，接口契约见其 README） ----
# 转换器基址：dev = 本机哑中继（deploy/svg-preview 的 dev edge）127.0.0.1:9900；生产 = internal 网络内 svg-preview:9900
PREVIEW_CONVERTER_URL=http://127.0.0.1:9900
# 转换管线版本：H1 S4 起固定 2.0.0，与容器 PIPELINE_VERSION 同值；旧 1.0.0 产物不再读取
PREVIEW_PIPELINE_VERSION=2.0.0
# 客户端超时（毫秒）：比容器内 10 秒硬超时留余量 —— 才拿得到 504 CONVERT_TIMEOUT 而不是裸超时
PREVIEW_CONVERT_TIMEOUT_MS=15000
# 可重试失败的最大尝试次数（含首次；到顶写产物 failed + outbox dead）与退避基数（毫秒）
PREVIEW_CONVERT_MAX_ATTEMPTS=3
PREVIEW_CONVERT_BACKOFF_MS=15000
# 超过该大小的源 SVG 直接降级「仅下载」（MB；与栅格化沙箱 20 MiB 定档值对齐）
PREVIEW_CONVERT_MAX_SOURCE_MB=20
# 预览地址短时签名有效期（秒）：读 API 签发地址的窗口，过期需重新请求（D2-04 短时签名 + 禁匿名）
PREVIEW_URL_TTL_SECONDS=300
# 预览转换队列开关（worker）：false = 只投递不消费（排障 / 压测用）
PREVIEW_JOB_ENABLED=true

# ---- 翻译通道（§6.16 ㉕ · Push 301：手打内容英译落库 · 服务端调内网引擎） ----
# 内网翻译引擎基址（LibreTranslate 兼容 POST /translate）；本机验证形态 = HY-MT1.5-1.8B 薄壳（llama.cpp 5007 + 薄壳 5008）
TRANSLATE_ORIGIN=http://127.0.0.1:5008
# 引擎调用超时（毫秒）
TRANSLATE_TIMEOUT_MS=20000

# ---- ONLYOFFICE 查看器（S3 · ADR-030：Office / 文本族预览由查看器承接；受控端点鉴权 = 与 DocServer 共享密钥） ----
# DocServer 浏览器侧基址（查看器配置 docServerUrl 下发；dev 沙箱 = deploy/onlyoffice 的 127.0.0.1:8001）
ONLYOFFICE_DOCSERVER_URL=http://127.0.0.1:8001
# 「DocServer 视角」API 基址（安全定稿 C1）：受控端点 URL 签发与 token payload.url 绑定的唯一同源配置（不信任 Host 头）；
# 容器部署 = DocServer 可达的 API 内网地址（如 http://api:3000；本机联调 = http://host.docker.internal:<api 端口>）
# WSL2 原生 Docker 的 host-gateway 映射由 deploy/onlyoffice dev compose 提供；API 需监听非 loopback（npm run start:api 默认满足）
ONLYOFFICE_DOCSERVER_API_BASE_URL=http://127.0.0.1:3000
# 与 DocServer JWT_SECRET 同值（查看器配置签发 + 受控端点 Bearer 自验）；生产必填（启动即校验）；空值 → 受控端点一律 401（fail closed）；真实值不落仓库
ONLYOFFICE_JWT_SECRET=
# 查看器配置 token TTL（秒；S8-2 定案 900）
ONLYOFFICE_JWT_TTL_SECONDS=900
# 受控端点签名校验时钟漂移容差（秒；C5：≤60s 且配置化）
ONLYOFFICE_JWT_CLOCK_TOLERANCE_SECONDS=60

# ---- Outbox 领取器（M4-05c → S7-1：领取 + 消费 + 重试 + dead；不含规则 / 通知编排） ----
# 分派轮询周期（毫秒）
OUTBOX_POLL_MS=5000
# 每主题单轮领取条数上限（单条最长占满客户端超时 90s；默认 2 与转换沙箱并发 2 对齐）
OUTBOX_BATCH_LIMIT=2
# 领取后超过该时长未回写视为 worker 崩溃遗留、可重领（毫秒；必须 >= PREVIEW_CONVERT_TIMEOUT_MS）
OUTBOX_STALE_MS=600000
# 领取者标识（进 outbox_events.locked_by；缺省 host:pid —— 多 worker 排障 / PoC-5 报告用）
WORKER_ID=

# ---- Outbox 运行时（S7-1：主题重试策略 / 告警探针 / done 行保留期） ----
# 通用主题重试上限（含首次）与指数退避（毫秒）：第 n 次失败后等 base * 2^(n-1)、封顶 max
# （preview.job 不适用：沿用 PREVIEW_CONVERT_MAX_ATTEMPTS / PREVIEW_CONVERT_BACKOFF_MS，封顶 30 分钟）
OUTBOX_DEFAULT_MAX_ATTEMPTS=5
OUTBOX_DEFAULT_BACKOFF_BASE_MS=15000
OUTBOX_DEFAULT_BACKOFF_MAX_MS=1800000
# 告警探针周期（毫秒）与阈值：待领取积压 > backlog / 最老待领取年龄 > oldest 仅作为内部信号记日志；
# 连续 OUTBOX_ALERT_STALL_PROBES 轮无 done 进度才合并升级 queue_stalled。窗口内新增死信 >= recent 只进入日报。
# 即时告警 = outbox.dead / queue_stalled / unconsumed_topic；出口 = 结构化日志 + 同一管理员告警群
# （配 OUTBOX_ALERT_WECOM_CHATID 且 WECOM_BOT_* 齐备时经智能机器人推送，失败 / 未配置回退结构化日志）
OUTBOX_ALERT_INTERVAL_MS=300000
# 持续告警复报冷却（毫秒）：queue_stalled / unconsumed_topic；恢复通知进入日报，不即时推送
OUTBOX_ALERT_REPEAT_MS=21600000
OUTBOX_ALERT_BACKLOG_MAX=1000
OUTBOX_ALERT_OLDEST_MS=900000
OUTBOX_ALERT_DEAD_RECENT_MAX=1
OUTBOX_ALERT_DEAD_WINDOW_MS=3600000
# 消费进度窗口（毫秒）与连续无进度探针轮数：过滤正常排空，避免积压阈值反复打扰
OUTBOX_ALERT_PROGRESS_WINDOW_MS=900000
OUTBOX_ALERT_STALL_PROBES=3
# 管理员日报固定每天 08:00（Asia/Shanghai）发送，统计前一自然日；由 jobs 持久化调度，无需配置周期
# 管理员告警群 chatid（企微智能机器人；只走密钥渠道，勿提交真实值）
OUTBOX_ALERT_WECOM_CHATID=
# done 行保留期（天，ADR-005 约 90 天）/ 单批删除条数 / 清理周期（毫秒）
OUTBOX_DONE_RETENTION_DAYS=90
OUTBOX_RETENTION_BATCH=1000
OUTBOX_RETENTION_INTERVAL_MS=21600000

# ---- Outbox 调度器（S7-3：cron 领取 + last_run_at 补发 + 单活 advisory lock） ----
# 单轮 tick 领取条数上限（到期任务按 run_at 序领取，逐条串行执行）
OUTBOX_SCHEDULER_BATCH_LIMIT=10
# 调度任务失败最大尝试次数（含首次；到顶置 jobs.status=failed，人工复位后继续）
OUTBOX_SCHEDULER_MAX_ATTEMPTS=5
# 补发跨度上限（天）：重启 / 停机错过的窗口超此跨度只记 job_runs.skipped 留痕（不补发轰炸）
OUTBOX_SCHEDULER_CATCHUP_MAX_DAYS=7
# 单轮 tick 最多处理的补发窗口数（水位护栏）：触顶时水位停在最后处理的窗口、剩余窗口下一轮顺延
OUTBOX_SCHEDULER_MAX_WINDOWS_PER_TICK=20

# ---- 通知投递（S7-4 · j1 / M5-04 首刀：站内信投递 / 同期合并 / 免打扰 / 每人每日上限 · Push 178） ----
# 站内信投递开关（worker）：false = notify.message 只投递不消费（排障 / 压测用）
NOTIFY_DELIVERY_ENABLED=true
# 延迟投递 flush 周期（毫秒）与单轮条数上限：免打扰 / 每日上限排队的行按 deliver_at 到期补投（不走 outbox 重试）
NOTIFY_FLUSH_INTERVAL_MS=60000
NOTIFY_FLUSH_BATCH=50
# 合并窗口（毫秒）：同人 + 同合并键、窗口内未读主行合并为一条；0 = 不合并（个人偏好可覆盖）
NOTIFY_MERGE_WINDOW_MS=1800000
# 缺省免打扰时段（HH:MM-HH:MM，Asia/Shanghai，允许跨零点；空串 = 关闭）与每人每日投递上限（0 = 不限）
NOTIFY_QUIET_HOURS=22:00-08:00
NOTIFY_DAILY_LIMIT=200
# 次日投递窗口起点（分钟；480 = 08:00）：每日上限溢出 / 免打扰结束的补发落点
NOTIFY_DAILY_WINDOW_START_MINUTE=480
# ---- SSE 实时流（S8-3 · M5-04-1：notification / unread 事件推送 · Push 211） ----
# 每用户最大并发 SSE 连接数（超出拒新 = 429）；心跳注释行周期（毫秒）
NOTIFY_STREAM_MAX_CONNECTIONS=3
NOTIFY_STREAM_HEARTBEAT_MS=25000
# 轮询兜底周期（毫秒）：0 = 关（LISTEN/NOTIFY 为主案）；> 0 时按周期补 unread 角标快照（弱实时兼容位）
NOTIFY_STREAM_POLL_MS=0

# ---- 稍后提醒到点触发（S8-3 · M5-04-2：C5-05 触发循环 · Push 212） ----
# 到点扫描周期（毫秒）：worker 常驻循环按 snooze_until 到期重提醒（免打扰顺延、不消耗每日上限）
NOTIFY_SNOOZE_SWEEP_INTERVAL_MS=60000
NOTIFY_SNOOZE_BATCH=50

# ---- 规则接线（S7-4 接线段 · M5-02：automation 规则 → notify.message 生产 · Push 180） ----
# 规则接线总开关（worker）：false = 不注册规则事件消费者与 automation-schedule.job（事件积压可见 · 排障态）
AUTOMATION_WIRING_ENABLED=true
# R06 项目完成喜报开关（项目编辑保存「已完成」时触发；false = 关闭）
AUTOMATION_R06_ENABLED=true
# 冷启动保护阈值（毫秒）：事件行创建时刻距今超此阈值 → 不评估主体、逐规则登记 event_too_old（消费掉不产消息）；
#   缺省 6 小时 —— 接线前积压的历史事件（重启 / 停机 / 首次上线）不补发业务通知
AUTOMATION_EVENT_MAX_AGE_MS=21600000

# ---- 企微通道（M5-03-1 · S8-1 客户端内核：token / 限速 / 错误码分类 · Push 215） ----
# 联调 / stub 回放可指向本地桩；生产 = https://qyapi.weixin.qq.com
WECOM_BASE_URL=https://qyapi.weixin.qq.com
# 自建应用凭据：Secret 属凭据（只走密钥渠道，真实值不落仓库）；生产必填校验随 M5-03-3 接线启用
WECOM_CORP_ID=
WECOM_AGENT_ID=0
WECOM_APP_SECRET=
# 单次 HTTP 超时（毫秒）
WECOM_TIMEOUT_MS=10000
# token 提前刷新余量（毫秒）
WECOM_TOKEN_SAFETY_MS=300000
# 自建应用限速窗口（毫秒）与窗口内上限（0 = 未启用；待 A5 实测回填）
WECOM_RATE_WINDOW_MS=60000
WECOM_RATE_LIMIT_APP=0

# ---- 企微智能机器人长连接（M5-03-2 · 群通道唯一发送面；webhook 面已退役） ----
# 长连接地址；联调 / stub 回放可指向本地桩
WECOM_BOT_WS_URL=wss://openws.work.weixin.qq.com
# 智能机器人凭据：Secret 属凭据（只走密钥渠道，真实值不落仓库）
WECOM_BOT_ID=
WECOM_BOT_SECRET=
# 机器人诊断开关（设置页「机器人诊断」块）：auto = 非 production 开启；true = 强制开启；false = 关闭。
# 开启后 GET /api/v1/wecom-dm-binding/diagnostics 会回 bot_id / secret 原文 —— 仅限本地联调，生产保持 auto。
WECOM_BOT_DIAGNOSTICS=auto
# 心跳周期（毫秒）：连续 2 周期无 pong 判失联重连
WECOM_BOT_PING_INTERVAL_MS=30000
# 单帧回执超时（毫秒）：订阅 / 推送共用
WECOM_BOT_ACK_TIMEOUT_MS=10000
# 重连退避下限 / 上限（毫秒）
WECOM_BOT_RECONNECT_MIN_MS=1000
WECOM_BOT_RECONNECT_MAX_MS=60000
# 按会话限速（Spike 实测口径：30 条/分钟 + 1000 条/小时；0 = 未启用）
WECOM_BOT_RATE_LIMIT_PER_MINUTE=30
WECOM_BOT_RATE_LIMIT_PER_HOUR=1000
# R06 动态海报（默认开启）：按项目真实数据生成姓名墙 PNG；生成失败才回退下方静态图
WECOM_R06_DYNAMIC_POSTER=true
# R06 动态海报字体（可选；空 = 仓库内思源宋体 SemiBold / Bold；如需其它已授权字体可填绝对路径）
WECOM_R06_FONT_SANS_PATH=
WECOM_R06_FONT_SANS_BOLD_PATH=
WECOM_R06_FONT_SERIF_PATH=
# R06 验收交付默认喜报图（可选；空 = 不追加图片；建议绝对路径，支持 PNG / JPG / GIF，≤10MB）
WECOM_R06_IMAGE_PATH=assets/wecom-r06-acceptance.gif
# R06 全部任务按时交付喜报图（可选；空 = 回退默认图）
WECOM_R06_ON_TIME_IMAGE_PATH=assets/wecom-r06-on-time.gif
# R06 项目完成且全部任务按时：文字后依次发 240×288 → 640×768 火箭 GIF，再发喜报海报（空 = 跳过）
WECOM_R06_ROCKET_240_IMAGE_PATH=assets/wecom-rocket-first-frame-240.gif
WECOM_R06_ROCKET_640_IMAGE_PATH=assets/wecom-rocket-first-frame-640.gif
# R06 其余情况：文字后发 200×200 火箭 GIF，再发喜报海报（空 = 跳过）
WECOM_R06_ROCKET_FALLBACK_IMAGE_PATH=assets/wecom-r06-acceptance.gif
