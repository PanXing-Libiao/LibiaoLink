# ============================================================
# LibiaoLink ONLYOFFICE 文档服务器（S2）· 本地沙箱示例
# ------------------------------------------------------------
# 规则（CONTRIBUTING §12）：真实值不入仓；本目录唯一「秘密」= OO_JWT_SECRET。
# 生成密钥（Node 内置 crypto，任一 shell 均可）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ============================================================

# 镜像（base 9.4.0.1 的 digest 固化在 Dockerfile FROM；自定义发布 tag 单独递增 —— 升级 = 改 tag + Dockerfile pin + 跑「升级回归五项」）
OO_IMAGE=libiaolink/onlyoffice-docs
OO_TAG=9.4.0.1-libiaolink.2

# 文档服务器 JWT（与 API 侧 ONLYOFFICE_JWT_SECRET 同值；未设置时 compose 拒绝启动）
OO_JWT_SECRET=

# 只发布到本机回环（dev 沙箱）；生产经网关 / 内网入口，另行配置
OO_PORT=8001

# 资源限额（首关沙箱口径 2C4G；生产按 ADR-013 容量档调整）
OO_MEM_LIMIT=4g
OO_CPUS=2
OO_TMPFS=512m
