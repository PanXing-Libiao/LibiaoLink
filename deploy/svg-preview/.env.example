# S3 沙箱示例。真实环境变量由部署平台注入；本目录不需要任何 Secret。
SVG_PREVIEW_IMAGE=libiaolink/svg-preview
SVG_PREVIEW_TAG=2.0.0
SVG_PREVIEW_BUILD_REVISION=local-s3
SVG_PIPELINE_VERSION=2.0.0
SVG_PREVIEW_PORT=9900

# ADR-034 定档；S3 实现只能收紧，不能放宽。
SVG_PREVIEW_TIMEOUT_MS=10000
SVG_PREVIEW_MAX_QUEUE=4
SVG_PREVIEW_MAX_SOURCE_BYTES=20971520
SVG_PREVIEW_MAX_OUTPUT_BYTES=20971520
SVG_PREVIEW_MAX_LONG_EDGE=4096
SVG_PREVIEW_MAX_PIXELS=16777216
SVG_PREVIEW_MAX_ASPECT_RATIO=16
SVG_PREVIEW_MAX_NATURAL_EDGE=1000000
SVG_PREVIEW_MAX_ELEMENTS=100000
SVG_PREVIEW_MEM_LIMIT=256m
SVG_PREVIEW_CPUS=1
SVG_PREVIEW_TMPFS=128m
SVG_PREVIEW_PIDS=64
SVG_PREVIEW_EDGE_MEM_LIMIT=64m
SVG_PREVIEW_EDGE_CPUS=0.25
