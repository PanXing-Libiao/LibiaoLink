# ============================================================
# LibiaoLink 生产部署（deploy/prod）· 非敏感变量示例
# ------------------------------------------------------------
# 用法：cp .env.example .env   （.env 已被 .gitignore 忽略；真实值不落仓库）
# 密钥不在本文件：全部放 secrets/（文件挂载，见 README「密钥清单」）
# ============================================================

# PostgreSQL 镜像：tag + digest 双锁（ADR-004 部署锁精确补丁；ADR-013 生产门禁）
# 当前 = 18.6（索引 digest，取自 docker buildx imagetools inspect postgres:18，2026-10-13）
PG_IMAGE=postgres:18@sha256:74935e72241653ca55e0414067e6d8763aceb8a810eb51b452253ec3dcfc4336
PG_DB=libiaolink
PG_SUPERUSER=postgres
# 只绑定 127.0.0.1（调试 / SSH 隧道用）
PG_PORT=5432
# 资源限额（12G 机器内存预算：PG 1G 档；见 M8 Runbook §1）
PG_MEM_LIMIT=1g
PG_CPUS=1

# 一次性运维容器（迁移 / 种子）：Node 工具镜像，tag + digest 双锁（同口径）
# 仅运维使用，非常驻服务；当前 = node 24（alpine）
NODE_IMAGE=node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
# tools 容器资源限额（拍脑袋给够即可；迁移只是文本 SQL）
TOOLS_MEM_LIMIT=512m
TOOLS_CPUS=1

# api / worker 资源限额（12G 内存预算：各 768M 档；不写 .env 时 compose 内置默认值相同）
API_MEM_LIMIT=768m
API_CPUS=1
WORKER_MEM_LIMIT=768m
WORKER_CPUS=1

# Nginx（web）：唯一对外入口；tag + digest 双锁；当前 = 1.30.5（2026-10-13，stable-alpine 解析后回填）
NGINX_IMAGE=nginx:1.30.5-alpine@sha256:0985e772fb9f729e6fa0980da05fca5d9c468e870eed43071545afa9d2e27d94
# 资源限额（12G 内存预算：web 64M 档，见 M8 Runbook §1）
WEB_MEM_LIMIT=64m
WEB_CPUS=0.5

# MinIO（对象存储）：服务器本地构建（GitHub Release 官方二进制 + minio/Dockerfile；quay 2026-10-13 实测下架）
MINIO_IMAGE=libiaolink/minio:RELEASE.2025-09-07T16-13-09Z
# 数据目录（数据盘 HDD；勿放系统盘）
MINIO_DATA_DIR=/srv/data/minio
# 资源限额（12G 内存预算：0.5G 档）
MINIO_MEM_LIMIT=512m
MINIO_CPUS=1
# 允许直传的浏览器来源（逗号分隔；= 站点来源；换域名 / TLS 后同步更新并重建容器）
MINIO_CORS_ALLOW_ORIGIN=https://test-pm.libiaorobot.com,http://10.1.104.44

# H1 S4 SVG 栅格化器：tag + digest 双锁（2026-10-21 测试机构建的 linux/amd64 镜像）
# 服务器需先 docker load 同 digest 的离线归档或从内网 registry 拉取；不得用 latest / 漂移 tag。
SVG_PREVIEW_IMAGE=libiaolink/svg-preview:2.0.0@sha256:eaee947e1e6a9e4b3ea7e7057e76e4ac45ac6209fb470593c46686ec7a474282
# 资源与沙箱限额（ADR-034 定档；仅可收紧，调整需重评审）
SVG_PREVIEW_MEM_LIMIT=256m
SVG_PREVIEW_CPUS=1
SVG_PREVIEW_PIDS=64
SVG_PREVIEW_TMPFS=128m
SVG_PREVIEW_MAX_QUEUE=4
SVG_PREVIEW_TIMEOUT_MS=10000
