# ============================================================
# deploy/prod/server.env · api / worker 生产环境（非敏感配置模板）
# ------------------------------------------------------------
# 用法：cp server.env.example server.env，按注释回填真实值（server.env 不进仓库）。
# 密钥全部由 secrets/ 注入：容器 entrypoint（scripts/service-entrypoint.cjs）
#   以 root 读 secrets/ 文件 → 注入环境变量 → 降权 node 运行；本文件不放任何密钥。
# 未列出的变量走 server/src/config/env.ts 的默认值（TTL / 批量 / 间隔等无需生产覆盖）；
#   完整清单见 server/.env.example（190 行）。
# 占位值一律用 *.invalid（保留域名，永不可解析）——一眼可辨「未配置」，且不阻断进程启动。
# ============================================================

NODE_ENV=production
# 容器内端口（仅在 compose 网络内；对外由 Nginx 承接）
PORT=3000
LOG_LEVEL=info

# ---- SSO（Casdoor；104.44 测试环境 2026-10-14 已回填 authtest 值；正式环境待 SSO 管理员创建 auth.libiaorobot.com 应用后回填） ----
# CASDOOR_CLIENT_ID / CASDOOR_CLIENT_SECRET 走 secrets/（casdoor_client_id / casdoor_client_secret）
CASDOOR_ISSUER=https://sso-placeholder.invalid
CASDOOR_REDIRECT_URI=https://placeholder.invalid/auth/callback
CASDOOR_SCOPE=openid profile email
CASDOOR_ORG_NAME=libiaorobot.com

# ---- 对象存储（本机 MinIO，见 deploy/prod/README.md §9；ACCESS_KEY / SECRET_KEY 走 secrets/） ----
# 预签名 URL 的 host 必须对浏览器可达 → https 同源门面（443 `/libiaolink/` → minio:9000：客户端网络仅放行
#   22/80/443）；9000 不发布宿主端口，9001 / 9443 仅绑定 127.0.0.1（SSH 隧道排障）。默认端口 → 签名 host 不含端口。
S3_ENDPOINT=https://test-pm.libiaorobot.com
S3_REGION=us-east-1
S3_BUCKET=libiaolink
S3_FORCE_PATH_STYLE=auto
# storage:init 用的 CORS 来源（= 站点来源；MinIO 实际生效的是 compose 的 MINIO_API_CORS_ALLOW_ORIGIN）
S3_CORS_ORIGINS=https://test-pm.libiaorobot.com
S3_ABORT_INCOMPLETE_DAYS=30

# ---- ONLYOFFICE 查看器（2026-10-14 已接真：门面 = 443 子路径 /onlyoffice/）----
#   ONLYOFFICE_DOCSERVER_URL = 浏览器可见地址（必须经 443 + 站点域名；前端据此加载 api.js）；
#   ONLYOFFICE_DOCSERVER_API_BASE_URL = DocServer 拉取地址（内网 api:3000；受控端点 URL 绑定基准）；
#   JWT secret 不走本文件：secrets/onlyoffice_jwt_secret → entrypoint 注入 ONLYOFFICE_JWT_SECRET，
#   必须与 DocServer 容器 OO_JWT_SECRET 同值（同值不变量 —— 否则预览 fail-closed 401）。
ONLYOFFICE_DOCSERVER_URL=https://test-pm.libiaorobot.com/onlyoffice
ONLYOFFICE_DOCSERVER_API_BASE_URL=http://api:3000

# ---- SVG 预览栅格化（H1 · S4；服务只在内网，不发布宿主端口） ----
# worker 与 svg-preview 同处 libiaolink-svg-preview-internal（internal=true）网络；
# 管线版本必须与镜像 PIPELINE_VERSION 同值，旧 1.0.0 产物不会再被读取。
PREVIEW_CONVERTER_URL=http://svg-preview:9900
PREVIEW_PIPELINE_VERSION=2.0.0
PREVIEW_CONVERT_TIMEOUT_MS=15000
PREVIEW_CONVERT_MAX_SOURCE_MB=20

# ---- CAD：默认关闭；通过 docker-compose.cad.yml 接入独立禁网沙箱（ADR-036） ----
# 生产 API 只接受 Unix socket，旧 CAD_ENGINE_PYTHON 不再启用解析。
CAD_ENGINE_SOCKET=
CAD_ENGINE_URL=
CAD_MAX_INPUT_MIB=64

# ---- 翻译通道（Push 309/310 · provider 可插拔；无可用通道时英译静默降级） ----
# openai = OpenAI 兼容 API（公司 New API 网关；Key 走 secrets/translate_api_key，不进本文件）；local = 本地 / 内网引擎
TRANSLATE_PROVIDER=openai
TRANSLATE_API_BASE_URL=https://newapi.libiaorobot.com/v1
TRANSLATE_API_MODEL=deepseek-v4-flash-vision-exp
# 备用 API 模型（Push 310：主模型失败自动接力；留空 = 不接力）
TRANSLATE_API_MODEL_FALLBACK=gemini-3.8-flash
# 本地引擎基址（provider=local 时使用；亦为 TRANSLATE_FALLBACK_ORIGIN 的接线位 —— 方案保留，暂不部署）
TRANSLATE_ORIGIN=http://translate-placeholder.invalid
TRANSLATE_FALLBACK_ORIGIN=

# ---- 企微（待业务侧开通后回填；Secret 走 secrets/） ----
WECOM_BASE_URL=https://qyapi.weixin.qq.com
WECOM_CORP_ID=
WECOM_AGENT_ID=0
WECOM_BOT_WS_URL=wss://openws.work.weixin.qq.com
# 智能机器人（群 + 单聊共用同一机器人 · 长连接）：M5-03-5 起单聊推送走智能机器人（绑定码链路）
# WECOM_BOT_ID / WECOM_BOT_SECRET 成对（Secret 属凭据，真实值只落服务器 server.env / 密钥渠道，不进仓库）
# 换机器人 = 改此二值即视为新机器人：新 bot_id 下无绑定行 → 单聊不发帧 + dead + 站内信降级（D4 话术），已绑定用户需重新绑定一次
WECOM_BOT_ID=
WECOM_BOT_SECRET=
# 管理员告警群 chatid（outbox 告警出口）
OUTBOX_ALERT_WECOM_CHATID=
# 持续告警复报间隔（毫秒；默认 6 小时）；恢复通知与死信汇总进入日报，不即时推送
OUTBOX_ALERT_REPEAT_MS=21600000
OUTBOX_ALERT_PROGRESS_WINDOW_MS=900000
OUTBOX_ALERT_STALL_PROBES=3
OUTBOX_ALERT_DIGEST_INTERVAL_MS=86400000

# ---- 一期口径开关（业务已定，勿改） ----
PERMISSION_ENFORCED=false
